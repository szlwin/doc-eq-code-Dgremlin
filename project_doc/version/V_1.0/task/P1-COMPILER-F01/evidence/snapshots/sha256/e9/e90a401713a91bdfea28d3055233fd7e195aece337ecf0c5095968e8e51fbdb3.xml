<?xml version="1.0" encoding="UTF-8"?>

<orm-rule-mapping>

    <!--
        RuleView 属于 user System，只能直接关联 user System 的 UserInfo。
        UserInfo 通过 root-property="user" 暴露本地根路径；当业务使用 OrderInfo 时，
        system/model-access 将 OrderInfo.user 显式映射到 UserInfo.user。
    -->

    <rule-view-info system="user" name="isActivated" view-ref="UserInfo">
        <rule
                name="checkActivated"
                type="checkPattern"
                pattern="user.status = 1"/>
    </rule-view-info>

    <rule-view-info system="user" name="isCertified" view-ref="UserInfo">
        <rule
                name="checkCertified"
                type="checkPattern"
                pattern="user.certified = 1"/>
    </rule-view-info>

</orm-rule-mapping>
