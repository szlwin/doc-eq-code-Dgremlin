  "acceptance_criteria": {
    "AC001": {
      "key": "AC001",
      "acceptance_id": "AC-P2-SYSTEM-RULEVIEW-001",
      "statement": "Given 当前真实 `systems.xml` 以及语义等价的多文件/重排输入 When 通过统一配置编译流程发现并编译 System 定义 Then 当前 fixture 的显式 System 均形成稳定一等身份，多文件和输入顺序变化不改变合法结果或 semantic digest And 重复/冲突 System 会产生稳定 ERROR，且失败不发布任何部分候选 Context。",
      "source_ref": "acceptance:AC-P2-SYSTEM-RULEVIEW-001",
      "status": "VERIFIED",
      "basis_evidence_ids": [
        "EVD-000486",
        "EVD-000487",
        "EVD-000488",
        "EVD-000489"
      ]
    },
    "AC002": {
      "key": "AC002",
      "acceptance_id": "AC-P2-SYSTEM-RULEVIEW-002",
      "statement": "Given 两个不同 System 均声明同名 RuleView，并另有同一 System 内重复同名的失败 fixture When 执行符号注册、引用解析和 Registry 发布 Then 跨 System 同名项以各自 `(system,name)` 同时存在且互不污染，同 System 重复项被拒绝 And 新 RuleView 缺失 System 时不会回退为裸名称全局注册。",
      "source_ref": "acceptance:AC-P2-SYSTEM-RULEVIEW-002",
      "status": "VERIFIED",
      "basis_evidence_ids": [
        "EVD-000486",
        "EVD-000487",
        "EVD-000488",
        "EVD-000489"
      ]
    },
    "AC003": {
      "key": "AC003",
      "acceptance_id": "AC-P2-SYSTEM-RULEVIEW-003",
      "statement": "Given 已发布的不同 System 同名 RuleView 和包含 `system-ref + rule-ref` 的调用事实 When 以正确/错误 System、正确/错误 RuleView 以及裸名称分别发起解析 Then 只有完整且存在的复合身份解析到目标 RuleView，错误或缺失身份得到稳定失败 And 不发生跨 System 同名搜索、裸名称 fallback 或错误 RuleView 执行。",
      "source_ref": "acceptance:AC-P2-SYSTEM-RULEVIEW-003",
      "status": "VERIFIED",
      "basis_evidence_ids": [
        "EVD-000486",
        "EVD-000487",
        "EVD-000488",
        "EVD-000489"
      ]
    },
    "AC004": {
      "key": "AC004",
      "acceptance_id": "AC-P2-SYSTEM-RULEVIEW-004",
      "statement": "Given 对同一模型/View/path 分别声明 READ、WRITE、EXECUTE 的允许与未声明组合 When 编译权限事实并对各访问类型执行判定 Then 每种访问意图仅在自身明确授权时允许，未声明共享 WRITE 默认拒绝，权限类型互不隐含 And 拒绝路径不会修改模型、推进状态或触发外部副作用。",
      "source_ref": "acceptance:AC-P2-SYSTEM-RULEVIEW-004",
      "status": "VERIFIED",
      "basis_evidence_ids": [
        "EVD-000486",
        "EVD-000487",
        "EVD-000488",
        "EVD-000489"
      ]
    },
    "AC005": {
      "key": "AC005",
      "acceptance_id": "AC-P2-SYSTEM-RULEVIEW-005",
      "statement": "Given rule/change/query 等消费者引用同一组合法路径、未知路径、穿越非法结构或目标不匹配路径 When 路径进入统一规范化和静态校验 Then 合法路径得到一致规范化身份，静态非法路径/目标在编译期产生 source-aware ERROR 并阻断发布 And 不使用模糊匹配、跨 View 搜索或不同消费者各自解释同一路径。",
      "source_ref": "acceptance:AC-P2-SYSTEM-RULEVIEW-005",
      "status": "VERIFIED",
      "basis_evidence_ids": [
        "EVD-000486",
        "EVD-000487",
        "EVD-000488",
        "EVD-000489"
      ]
    },
    "AC006": {
      "key": "AC006",
      "acceptance_id": "AC-P2-SYSTEM-RULEVIEW-006",
      "statement": "Given 一条静态结构合法但最终对象依赖运行时值的访问，以及允许和拒绝两种运行态 When 该访问到达受保护读取/写入/执行边界 Then 编译结果明确要求 runtime check，Guard 对允许态放行、对拒绝态在副作用前 DENY And “静态不可完全判定”不会被当作默认允许，Guard 不可用时也不会 fail-open。",
      "source_ref": "acceptance:AC-P2-SYSTEM-RULEVIEW-006",
      "status": "VERIFIED",
      "basis_evidence_ids": [
        "EVD-000486",
        "EVD-000487",
        "EVD-000488",
        "EVD-000489"
      ]
    },
