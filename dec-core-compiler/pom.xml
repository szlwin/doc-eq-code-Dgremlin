<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>doc.eq.code</groupId>
        <artifactId>doc-eq-code-parent</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>dec-core-compiler</artifactId>
    <name>DEC Core Compiler</name>

    <dependencies>
        <dependency>
            <groupId>doc.eq.code</groupId>
            <artifactId>dec-core-context</artifactId>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../dec-demo/src/main/resources</directory>
                <targetPath>main-fixture</targetPath>
                <filtering>false</filtering>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../dec-demo/src/test/resources</directory>
                <targetPath>test-fixture</targetPath>
                <filtering>false</filtering>
            </testResource>
        </testResources>
    </build>
</project>
