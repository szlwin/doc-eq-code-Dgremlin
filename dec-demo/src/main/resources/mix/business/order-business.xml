<?xml version="1.0" encoding="UTF-8"?>

<!--
    目标设计示例：

    - OrderInfo 是跨 user、order、payment System 的共享业务模型；
    - Information 通过 system-ref 指定识别或物化能力的归属；
    - Directory Action 通过 system-ref + rule-ref 调用指定 System 的 RuleView；
    - 无 rule-ref 的 Action 由全局自定义 Action 注册表提供；
    - Produce 映射实际数据与 Information。
-->
<business-config name="order-payment">

    <!-- ========================================================= -->
    <!-- 信息树                                                     -->
    <!-- ========================================================= -->

    <information-info>

        <!-- 用户信息：由 user System 在共享 OrderInfo.user 上识别。 -->

        <information
                name="user.activated"
                system-ref="user"
                model-ref="OrderInfo"
                rule-ref="isActivated"/>

        <information
                name="user.certified"
                system-ref="user"
                model-ref="OrderInfo"
                rule-ref="isCertified"/>

        <information
                name="user.effective"
                expression="
                    user.activated
                    and
                    user.certified
                "/>

        <!-- 订单信息：由 order System 负责识别和物化。 -->

        <information
                name="order.ordered"
                system-ref="order"
                model-ref="OrderInfo"
                rule-data="
                    status = 1
                    and
                    every(orderDetailList, status = 1)
                ">

            <change-data>
                <![CDATA[
                    status : 1;
                    every(orderDetailList, status : 1);
                ]]>
            </change-data>

        </information>

        <information
                name="order.waitPay"
                system-ref="order"
                model-ref="OrderInfo"
                rule-ref="isWaitPay"/>

        <information
                name="order.payable"
                expression="
                    order.ordered
                    or
                    order.waitPay
                "/>

        <information
                name="order.paying"
                system-ref="order"
                model-ref="OrderInfo"
                rule-data="
                    status = 2
                    and
                    every(orderDetailList, status = 2)
                ">

            <change-data>
                <![CDATA[
                    status : 2;
                    every(orderDetailList, status : 2);
                ]]>
            </change-data>

        </information>

        <!-- 支付信息：由 payment System 在共享 OrderInfo.payInfo 上识别。 -->

        <information
                name="payment.paymentInfo"
                system-ref="payment"
                model-ref="OrderInfo"
                rule-ref="hasPaymentInfo"/>

        <information
                name="payment.hasResult"
                system-ref="payment"
                model-ref="OrderInfo"
                rule-ref="hasPayResult"/>

        <information
                name="payment.success"
                system-ref="payment"
                model-ref="OrderInfo"
                rule-ref="isPaySuccess"/>

        <information
                name="payment.error"
                system-ref="payment"
                model-ref="OrderInfo"
                rule-ref="isPayError"/>

        <information
                name="payment.completed"
                expression="
                    payment.success
                    or
                    payment.error
                "/>

        <!-- 支付成功后的订单信息。 -->

        <information
                name="order.paySuccessStatus"
                system-ref="order"
                model-ref="OrderInfo"
                rule-data="
                    status = 3
                    and
                    every(orderDetailList, status = 3)
                ">

            <change-data>
                <![CDATA[
                    status : 3;
                    every(orderDetailList, status : 3);
                ]]>
            </change-data>

        </information>

        <information
                name="order.paySuccess"
                expression="
                    payment.success
                    and
                    order.paySuccessStatus
                "/>

        <!-- 支付失败后的订单信息。 -->

        <information
                name="order.payErrorStatus"
                system-ref="order"
                model-ref="OrderInfo"
                rule-data="
                    status = 4
                    and
                    every(orderDetailList, status = 4)
                ">

            <change-data>
                <![CDATA[
                    status : 4;
                    every(orderDetailList, status : 4);
                ]]>
            </change-data>

        </information>

        <information
                name="order.payError"
                expression="
                    payment.error
                    and
                    order.payErrorStatus
                "/>

    </information-info>

    <!-- ========================================================= -->
    <!-- 目录                                                       -->
    <!-- ========================================================= -->

    <directory-info>

        <!--
            订购阶段只调用 order System 的 save-Order。
            legacy save-Order 中的支付规则已经拆到 payment System 的 pay RuleView。
        -->
        <directory
                name="ordered"
                information-ref="order.ordered"
                model-ref="OrderInfo"
                is-root="true">

            <subdirectory-info>
                <subdirectory rel="paying"/>
            </subdirectory-info>

            <action-info>

                <action
                        name="saveOrder"
                        system-ref="order"
                        rule-ref="save-Order">

                    <produce-info>
                        <produce
                                ref="OrderInfo"
                                information-ref="order.ordered"/>
                    </produce-info>

                </action>

            </action-info>

        </directory>

        <!--
            支付阶段使用同一个 OrderInfo，
            但 payment System 只能写 payInfo 和 payInfo.payDetailList。
        -->
        <directory
                name="paying"
                information-ref="order.paying"
                model-ref="OrderInfo">

            <subdirectory-info>

                <subdirectory rel="PayResult">

                    <back name="returnPaying">
                        <action-info>
                            <action
                                    name="resetPayResult"
                                    system-ref="payment"
                                    rule-ref="resetPayResult"/>
                        </action-info>
                    </back>

                </subdirectory>

            </subdirectory-info>

            <dependency-info>
                <dependency information-ref="order.payable"/>
                <dependency information-ref="user.effective"/>
            </dependency-info>

            <action-info>

                <action
                        name="startPay"
                        system-ref="payment"
                        rule-ref="pay">

                    <produce-info>
                        <produce
                                ref="PaymentInfo"
                                information-ref="payment.paymentInfo"/>
                    </produce-info>

                </action>

            </action-info>

            <change-info information-ref="order.paying"/>

        </directory>

        <!-- 支付结果由 payment System 接收并写回共享 OrderInfo.payInfo。 -->
        <directory
                name="PayResult"
                information-ref="payment.hasResult"
                model-ref="OrderInfo">

            <subdirectory-info>

                <subdirectory
                        rel="success"
                        information-ref="payment.success"
                        mutual-exclusion="error"
                        any-one="true"/>

                <subdirectory
                        rel="error"
                        information-ref="payment.error"
                        mutual-exclusion="success"
                        any-one="true"/>

            </subdirectory-info>

            <action-info>

                <action
                        name="receivePayResult"
                        system-ref="payment"
                        rule-ref="receivePayResult">

                    <produce-info>
                        <produce
                                ref="PayResult"
                                information-ref="payment.hasResult"/>
                    </produce-info>

                </action>

            </action-info>

        </directory>

        <!-- 支付成功后由 order System 完成订单侧处理。 -->
        <directory
                name="success"
                information-ref="order.paySuccess"
                model-ref="OrderInfo">

            <dependency-info>
                <dependency information-ref="payment.success"/>
            </dependency-info>

            <action-info>
                <action
                        name="confirmPaySuccess"
                        system-ref="order"
                        rule-ref="confirmPaySuccess"/>
            </action-info>

            <change-info information-ref="order.paySuccessStatus"/>

        </directory>

        <!--
            支付失败先由 payment System 记录错误，
            再调用全局注册的 smsNotify，最后由 order System 处理订单侧失败结果。
        -->
        <directory
                name="error"
                information-ref="order.payError"
                model-ref="OrderInfo">

            <dependency-info>
                <dependency information-ref="payment.error"/>
            </dependency-info>

            <action-info>

                <action
                        name="recordPyaError"
                        system-ref="payment"
                        rule-ref="recordPyaError">

                    <produce-info>
                        <produce ref="PyaError"/>
                    </produce-info>

                </action>

                <action name="smsNotify"/>

                <action
                        name="confirmPayError"
                        system-ref="order"
                        rule-ref="confirmPayError"/>

            </action-info>

            <change-info information-ref="order.payErrorStatus"/>

        </directory>

    </directory-info>

</business-config>
