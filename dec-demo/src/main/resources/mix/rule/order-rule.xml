<?xml version="1.0" encoding="UTF-8"?>

<orm-rule-mapping>

    <!--
        legacy system/test-rule/orm-rule.xml 中 save-Order 的订单部分：
        只保存订单主数据和订单明细。
    -->
    <rule-view-info name="save-Order" view-ref="OrderInfo">

        <rule
                name="insertOrder"
                type="insert"
                property="OrderInfo"/>

        <rule
                name="insertOrderDetail"
                type="insert"
                property="orderDetailList"/>

    </rule-view-info>

    <rule-view-info name="isWaitPay" view-ref="OrderInfo">
        <rule
                name="checkWaitPay"
                type="checkPattern"
                pattern="status = 1"/>
    </rule-view-info>

    <!--
        订单状态本身由 Information.change-data 物化。
        下列 RuleView 用于订单模块在支付结果后的附加业务处理。
    -->
    <rule-view-info name="confirmPaySuccess" view-ref="OrderInfo">
        <rule name="confirmPaySuccess" type="grammer">
            <customer-process>
                <![CDATA[
                    #orderPayResult : "SUCCESS";
                ]]>
            </customer-process>
        </rule>
    </rule-view-info>

    <rule-view-info name="confirmPayError" view-ref="OrderInfo">
        <rule name="confirmPayError" type="grammer">
            <customer-process>
                <![CDATA[
                    #orderPayResult : "ERROR";
                ]]>
            </customer-process>
        </rule>
    </rule-view-info>

</orm-rule-mapping>
